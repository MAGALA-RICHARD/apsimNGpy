                  "Name": "Wheat.Leaf",
                  "LiveDigestibility": "0.7",
                  "DeadDigestibility": "0.3",
                  "LiveFractionConsumable": 1.0,
                  "DeadFractionConsumable": 1.0,
                  "LiveMinimumBiomass": 100.0,

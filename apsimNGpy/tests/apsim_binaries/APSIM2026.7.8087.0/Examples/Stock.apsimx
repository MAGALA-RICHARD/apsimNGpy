            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.PMF.Interfaces;",
                "using System.Diagnostics;",
                "using Models.AgPasture;",
                "using System.Linq;",
                "using System.Collections.Generic;",
                "using System.Collections;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using System.Xml.Serialization;",
                "using APSIM.Shared.Utilities;",
                "using Models.GrazPlan;",
                "using Models.Utilities;",
                "using Models.Core;",
                "using Models;",
                "using System;",
                "",
                "namespace Models",
                "{",
                "",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock clock;",
                "        [Link] Stock stock;",
                "        [Link] Supplement supplement;",
                "        [Link] List<Zone> paddocks;",
                "        [Link] ISummary summary;",
                "        [Link] Simulation farm;",
                "        [Link] List<IPlantDamage> forages = null;",
                "",
                "        private int CurrentGroupNum = 1;    // animal group number",
                "        private int CurrentLocationNum { get; set; }",
                "",
                "        [Separator(\"Stock type info - these stock are bought at the start of the simulation\")]",
                "",
                "        [Description(\"Whole-farm stocking rate (head/ha): \")] ",
                "        public double StockingRate { get; set; } ",
                "",
                "        [Description(\"Stock: genotype (e.g. Small Merino, Angus, Friesian):\")] ",
                "        [Display(Values=\"GetGenotypes\")]",
                "        public string Genotype { get; set; }",
                "",
                "        [Description(\"Stock: sex (Female, Male, Castrate):\")] ",
                "        public ReproductiveType Sex { get; set; }",
                "",
                "        [Description(\"Stock: age (months):\")] ",
                "        public double Age { get; set; }",
                "",
                "        [Description(\"Stock: weight (kg liveweight /head):\")] ",
                "        public double Weight { get; set; }",
                "",
                "        [Description(\"Stock: fertility status (0 if non-pregnant or days since conception):\")] ",
                "        public int Pregnant { get; set; }",
                "",
                "        [Description(\"Stock: lactation status (0 if non-lactating or days since parturition):\")]",
                "        public int Lactating { get; set; }",
                "",
                "        [Description(\"Stock: number of unweaned young:\")]",
                "        public int YoungNumber { get; set; }",
                "",
                "        [Description(\"Stock: weight of unweaned young:\")] ",
                "        public double YoungWt { get; set; }",
                "",
                "        public int NumStock { get; set; }",
                "",
                "        // Return a list of genotypes to the properties tab.",
                "        public string[] GetGenotypes()",
                "        {",
                "            if (stock != null)",
                "                return stock.Genotypes.Names.ToArray();",
                "            return null;",
                "        }",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                "        {",
                "",
                "            //Debugger.Break();",
                "",
                "            summary.WriteMessage(this, \"Initialising the paddock information\", MessageType.Diagnostic);",
                "",
                "            NumStock = (int)(Math.Round(StockingRate * farm.Area, 0));",
                "",
                "            BuyStock();",
                "            summary.WriteMessage(this, \"     Number of stock bought is \" + NumStock, MessageType.Diagnostic);",
                "            summary.WriteMessage(this, \"     The number of animals has been rounded to \" + NumStock + \" from \" + (StockingRate * farm.Area), MessageType.Diagnostic);",
                "            summary.WriteMessage(this, \"     The area of the whole farm is \" + farm.Area + \" ha\", MessageType.Diagnostic);",
                "",
                "        }",
                "",
                "        public void BuyStock()",
                "        {",
                "            CurrentGroupNum = stock.NoGroups + 1;",
                "            StockBuy purchase = new StockBuy();",
                "            purchase.Genotype = Genotype;",
                "            purchase.Number = NumStock;",
                "            purchase.Sex = Sex;",
                "            purchase.Age = Age;       // age in months",
                "            purchase.Weight = Weight;  // live weight in kg",
                "            purchase.UseTag = CurrentGroupNum + 1;",
                "            purchase.MatedTo = purchase.Genotype;",
                "            purchase.Pregnant = Pregnant;  // days pregnant, 0 = non pregnant, 1 = pregnant",
                "            purchase.Lactating = Lactating;  // 0 for dry, 1 for lactating",
                "            purchase.NumYoung = YoungNumber;",
                "            purchase.YoungWt = YoungWt;",
                "",
                "            stock.Buy(purchase);",
                "        }",
                "",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "StockingRate",
                  "Value": "5"
                },
                {
                  "Key": "Genotype",
                  "Value": "Angus"
                },
                {
                  "Key": "Sex",
                  "Value": "Castrate"
                },
                {
                  "Key": "Age",
                  "Value": "12"
                },
                {
                  "Key": "Weight",
                  "Value": "100"
                },
                {
                  "Key": "Pregnant",
                  "Value": "0"
                },
                {
                  "Key": "Lactating",
                  "Value": "0"
                },
                {
                  "Key": "YoungNumber",
                  "Value": "0"
                },
                {
                  "Key": "YoungWt",
                  "Value": "0"
                }
              ],
              "Name": "BuyStock",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System.Diagnostics;",
                "using Models.AgPasture;",
                "using System.Collections.Generic;",
                "using System.Collections;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using System.Xml.Serialization;",
                "using APSIM.Shared.Utilities;",
                "using Models.GrazPlan;",
                "using Models.Utilities;",
                "using Models.Core;",
                "using System;",
                "using System.Linq;",
                "using Models.ForageDigestibility;",
                "",
                "namespace Models",
                "{",
                "",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock Clock;",
                "        [Link] Stock Cows;",
                "        [Link] Supplement Supplement;",
                "        [Link] Zone[] Paddocks;",
                "        [Link] ISummary summary = null;",
                "        [Link] Simulation Farm;",
                "        [Link] Forages forages = null;",
                "",
                "        //List<AgPasture.PastureSpecies> Pasture = new List<AgPasture.PastureSpecies>();",
                "",
                "        [Serializable]",
                "        public class PaddockInfo",
                "        {",
                "            public Zone Field { get; }",
                "            public IEnumerable<ModelWithDigestibleBiomass> Forages { get; }",
                "            public double HarvestableBiomass",
                "            {",
                "                get",
                "                {",
                "                    double total = 0;",
                "                    foreach (var model in Forages)",
                "                        foreach (var material in model.Material)",
                "                            total += material.Consumable.Wt * 10; // g/m2 to kg/ha",
                "                    return total;            ",
                "                }",
                "            }",
                "            ",
                "            ",
                "            public PaddockInfo(IEnumerable<ModelWithDigestibleBiomass> forages, Zone field)",
                "            {",
                "                Field = field;",
                "                Forages = forages;",
                "            }",
                "        }",
                "",
                "        [Description(\"Do verbose reporting from this script (tick for yes): \")] ",
                "        public bool DoVerbose { get; set; }",
                "",
                "        [Separator(\"Whole farm and initial location\")]",
                "",
                "        [Description(\"Initial location of the cows (paddock name):\")] ",
                "        [Display(Type=DisplayType.Model, ModelType=typeof(Zone))]",
                "        public IModel InitialLocation { get; set; }",
                "",
                "       [Description(\"Whole-farm stocking rate (head/ha): \")]",
                "        public double StockingRate { get; set; } ",
                "",
                "        [Separator(\"Settings for the rotation\")]",
                "",
                "        [Description(\"Target rotation length (days/paddock): \")] ",
                "        public int TargetRotationLength { get; set; }",
                "",
                "        [Description(\"Post-grazing residual to trigger pasture conservation (kgDM/ha): \")] ",
                "        public double PostGrazingResidual { get; set; }",
                "",
                "        [Description(\"Post-cutting residual (kgDM/ha): \")] ",
                "        public double PostCuttingResidual { get; set; }",
                "",
                "        [Description(\"Harvest excess herbage above residual when cows leave the paddock?: \")] ",
                "        public bool HarvestExcessHerbage { get; set; }",
                "",
                "        [Separator(\"Settings for supplementary feeding\")]",
                "",
                "        [Description(\"Baseline (i.e. every day) feeding of silage (kgDM/head/day): \")] ",
                "        public double SilageEveryDay { get; set; }",
                "",
                "        [Description(\"Low pre-grazing pasture mass feeding (additional to baseline) of silage (kgDM/head/day): \")] ",
                "        public double SilageOnPastureMass { get; set; }",
                "",
                "        [Description(\"Trigger pre-grazing pasture mass for the rule above (kgDM/ha): \")] ",
                "        public double TriggerPastureMass { get; set; }",
                "",
                "        public int NumCows { get; set; } // number of cows on the whole farm",
                "        public string pastLocationName { get; set; }  // ",
                "        public string newLocationName { get; set; }  // ",
                "        public int CurrentLocationNum { get; set; }  // name of the paddock that the cows are currently in",
                "        public string CurrentLocationName { get; set; }",
                "        public int NumPaddocks { get; set; }",
                "        public double SilageHarvested { get; set; } // RAmount of silage harvested (kg DM /ha)",
                "",
                "        //public double[] HarvestableBiomass { get; set; }",
                "",
                "        private int group_count; // how many groups are there in the simulation",
                "        private int g = 1;      // index to the groups of animals",
                "",
                "        //private int DaysPerPaddock;",
                "        private int DaysInThisPaddock;",
                "        private bool MoveToday = false;",
                "        private bool Initialised = false;",
                "        public double BiomassInCurrentPaddock;",
                "",
                "        public event BiomassRemovedDelegate BiomassRemoved;",
                "        public List<PaddockInfo> listOfPaddockInfo { get; set; }",
                "",
                "",
                "        private void Initialise()",
                "        {",
                "            summary.WriteMessage(this, \"Initialising the paddock information\", MessageType.Diagnostic);",
                "            listOfPaddockInfo = new List<PaddockInfo>();",
                "            CurrentLocationName = InitialLocation.Name;",
                "",
                "            GetPaddockInfo();",
                "            //HarvestableBiomass = Farm.",
                "",
                "            NumCows = (int)(Math.Round(StockingRate * Farm.Area, 0));",
                "",
                "            //SetInitialCowStuff();",
                "",
                "            if (NumCows > 0)",
                "                Cows.Move(CurrentLocationName);",
                "",
                "            summary.WriteMessage(this, \"     The number of animals has been rounded to \" + NumCows + \" from \" + (StockingRate * Farm.Area), MessageType.Diagnostic);",
                "            summary.WriteMessage(this, \"     The animals will begin in \" + CurrentLocationName + \" which is paddock number \" + CurrentLocationNum + \" in the simulation\", MessageType.Diagnostic);",
                "            summary.WriteMessage(this, \"     The area of the whole farm is \" + Farm.Area + \" ha\", MessageType.Diagnostic);",
                "",
                "            DaysInThisPaddock = -1;",
                "            SilageHarvested = 0.0;",
                "            Initialised = true;",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (!Initialised)",
                "                Initialise();",
                "            SilageHarvested = 0.0;",
                "",
                "            // WTF is this?",
                "            if ((Cows.LactatingAll > 2) && (Cows.NoSucklingAll > 0))",
                "                WeanCalves();",
                "            if ((Cows.LactatingAll > 4) && (Cows.LactatingAll < 6))",
                "                SellCalves();",
                "",
                "            MoveToday = false;",
                "            // how many days in this paddock?  Ready to move?",
                "            DaysInThisPaddock += 1;",
                "            if (DaysInThisPaddock >= TargetRotationLength)",
                "            {",
                "                MoveToday = true;",
                "",
                "                pastLocationName = CurrentLocationName;",
                "                if (CurrentLocationNum < NumPaddocks - 1)",
                "                {",
                "                    CurrentLocationNum += 1;",
                "                    newLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;",
                "                }",
                "                else",
                "                {",
                "                    CurrentLocationNum = 0;",
                "                    newLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;",
                "                }",
                "                CurrentLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;",
                "",
                "",
                "                if (HarvestExcessHerbage)",
                "                {",
                "                    foreach (Zone paddock in Paddocks)",
                "                    {",
                "                        if (paddock.Name == pastLocationName)",
                "                        {",
                "                            double pastPaddockBiomass = 0.0;",
                "                            foreach (var forage in forages.ModelsWithDigestibleBiomass.Where(f => f.Zone.Name == pastLocationName))",
                "                                pastPaddockBiomass += forage.Material.Sum(f => f.Total.Wt) * 10;   // kg/ha ",
                "",
                "                            if (pastPaddockBiomass > PostGrazingResidual)  //why the 250? Because don't harvest very small amounts ...",
                "                            {",
                "                                foreach (var forage in forages.ModelsWithDigestibleBiomass.Where(f => f.Zone.Name == pastLocationName))",
                "                                {",
                "                                    var aboveGroundWt = forage.Material.Sum(f => f.Total.Wt) * 10;  // kg/ha ",
                "                                    var amountToRemove = aboveGroundWt / pastPaddockBiomass * PostCuttingResidual;",
                "                                    forage.RemoveBiomass(type: \"SetResidueAmount\", amount: amountToRemove / 10);",
                "                                    SilageHarvested += amountToRemove;",
                "                                }",
                "",
                "",
                "                            }",
                "                        }",
                "                    }",
                "                }",
                "",
                "                if (NumCows > 0)",
                "                    Cows.Move(listOfPaddockInfo[CurrentLocationNum].Field.Name);",
                "                   ",
                "                if (DoVerbose)",
                "                    summary.WriteMessage(this, \"moving Stock to \" + listOfPaddockInfo[CurrentLocationNum].Field.Name, MessageType.Diagnostic);",
                "",
                "                DaysInThisPaddock = 0;",
                "            }",
                "",
                "            if (SilageEveryDay > 0)",
                "            {",
                "            // see how much supplement there is - buy more if needed",
                "            // Stores 1 is from a pasture component so bought supplements start at 2",
                "                double silageOnHand = Supplement.Stores[2 - 1].Stored;",
                "                if (silageOnHand < SilageEveryDay * Cows.NumberAll)",
                "                {",
                "                    Supplement.Buy(SilageEveryDay * 180 * Cows.NumberAll, \"silage_highquality\");  // i.e. 6 months worth",
                "                    summary.WriteMessage(this, \"SilageEveryDay: Buying silage_highquality of total amount : \" + (SilageEveryDay * 180 * Cows.NumberAll) + \" kg DM\", MessageType.Diagnostic);",
                "                }",
                "                Supplement.Feed(\"silage_highquality\", SilageEveryDay * Cows.NumberAll, CurrentLocationName, false);",
                "            }",
                "",
                "            if ((SilageOnPastureMass > 0) && (listOfPaddockInfo[CurrentLocationNum].HarvestableBiomass < TriggerPastureMass))",
                "            {",
                "                double silageOnHand = Supplement.Stores[2 - 1].Stored;",
                "                if (silageOnHand < SilageOnPastureMass * Cows.NumberAll)",
                "                {",
                "                    Supplement.Buy(SilageOnPastureMass * 180 * Cows.NumberAll, \"silage_highquality\");",
                "                    summary.WriteMessage(this, \"SilageOnPastureMass: Buying silage_highquality of total amount : \" + (SilageOnPastureMass * 180 * Cows.NumberAll) + \" kg DM\", MessageType.Diagnostic);",
                "                }",
                "                Supplement.Feed(\"silage_highquality\", SilageOnPastureMass * Cows.NumberAll, CurrentLocationName, false);",
                "            }",
                "",
                "            // capture the pre-grazing biomass before the DoStock event",
                "            BiomassInCurrentPaddock = listOfPaddockInfo[CurrentLocationNum].HarvestableBiomass;",
                "",
                "        } // End of Do Management",
                "",
                "",
                "        public void WeanCalves()",
                "        {",
                "                Cows.Wean(Cows.NumberAll, weanMales:true, weanFemales:true);",
                "        }",
                "",
                "        public void SellCalves()",
                "        {",
                "            double weanAge = 0.25 * 365;",
                "",
                "            Cows.SplitByAge(Convert.ToInt32(weanAge));",
                "",
                "              foreach (var animalGroup in Cows.AnimalGroups)",
                "              {",
                "                  if (animalGroup.AgeDays < weanAge)",
                "                      Cows.Sell(animalGroup.NoAnimals);",
                "              }",
                "        }",
                "",
                "",
                "        public void GetPaddockInfo()",
                "        {",
                "            NumPaddocks = 0;",
                "            CurrentLocationNum = 0;",
                "",
                "            foreach (Zone paddock in Paddocks)",
                "            {",
                "                NumPaddocks += 1;",
                "",
                "                var paddockInfo = new PaddockInfo(forages.ModelsWithDigestibleBiomass.Where(f => f.Zone == paddock), paddock);",
                "                listOfPaddockInfo.Add(paddockInfo);",
                "",
                "                summary.WriteMessage(this, \"     Paddock \" + NumPaddocks + \" is called \" + paddock.Name + \", has an area of \" + paddock.Area + \" ha and an initial harvestable biomass of \" + paddockInfo.HarvestableBiomass + \" kg DM / ha\", MessageType.Diagnostic);",
                "",
                "            }",
                "            ",
                "            CurrentLocationNum = listOfPaddockInfo.FindIndex(p => p.Field.Name == CurrentLocationName);",
                "            if (CurrentLocationNum == -1)",
                "                throw new Exception($\"Cannot find paddock {CurrentLocationName}\");",
                "",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "DoVerbose",
                  "Value": "True"
                },
                {
                  "Key": "InitialLocation",
                  "Value": "[Paddock01]"
                },
                {
                  "Key": "TargetRotationLength",
                  "Value": "20"
                },
                {
                  "Key": "PostGrazingResidual",
                  "Value": "1500"
                },
                {
                  "Key": "PostCuttingResidual",
                  "Value": "1000"
                },
                {
                  "Key": "HarvestExcessHerbage",

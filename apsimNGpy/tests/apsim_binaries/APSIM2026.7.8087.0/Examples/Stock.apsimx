                },
                {
                  "Key": "SilageOnPastureMass",
                  "Value": "10"
                },
                {
                  "Key": "TriggerPastureMass",
                  "Value": "2000"
                },
                {
                  "Key": "StockingRate",
                  "Value": "5"
                }
              ],

            {
              "$type": "Models.Memo, Models",
              "Text": "**Stock**\r\n\r\nAll the paramters for Stock are set in GrazeForageCrop.\r\n",
              "Name": "Stock Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.PMF.Interfaces;",
                "using System.Diagnostics;",
                "using Models.AgPasture;",
                "using System.Linq;",
                "using System.Collections.Generic;",
                "using System.Collections;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using System.Xml.Serialization;",
                "using APSIM.Shared.Utilities;",
                "using Models.GrazPlan;",
                "using Models.Utilities;",
                "using Models.Core;",
                "using Models;",
                "using System;",
                "",
                "namespace Models",
                "{",
                "",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock clock;",
                "        [Link] Stock stock;",
                "        [Link] Supplement supplement;",
                "        [Link] List<Zone> paddocks;",
                "        [Link] ISummary summary;",
                "        [Link] Simulation farm;",
                "        [Link] List<IOrganDamage> forages = null;",
                "",
                "        private int CurrentGroupNum = 1;    // animal group number",
                "        private int CurrentLocationNum { get; set; }",
                "        private string CurrentZone;",
                "",
                "        [Separator(\"Stock type info, the same type of stock are brought onto the paddock at each grazing\")]",
                "",
                "        [Description(\"Stock: genotype (e.g. Small Merino, Angus, Friesian):\")] ",
                "        [Display(Values=\"GetGenotypes\")]",
                "        public string Genotype { get; set; }",
                "",
                "        [Description(\"Stock: sex (Female, Male, Castrate):\")] ",
                "        public ReproductiveType Sex { get; set; }",
                "",
                "        [Description(\"Stock: age (months):\")] ",
                "        public double Age { get; set; }",
                "",
                "        [Description(\"Stock: weight (kg liveweight /head):\")] ",
                "        public double Weight { get; set; }",
                "",
                "        [Description(\"Stock: fertility status (0 if non-pregnant or days since conception):\")] ",
                "        public int Pregnant { get; set; }",
                "",
                "        [Description(\"Stock: lactation status (0 if non-lactating or days since parturition):\")]",
                "        public int Lactating { get; set; }",
                "",
                "        [Description(\"Stock: number of unweaned young:\")]",
                "        public int YoungNumber { get; set; }",
                "",
                "        [Description(\"Stock: weight of unweaned young:\")] ",
                "        public double YoungWt { get; set; }",
                "",
                "        [Separator(\"Grazing event information\")]",
                "",
                "        [Description(\"Paddock stocking rate (head/ha): \")] ",
                "        public double StockingRate { get; set; }",
                "",
                "        [Description(\"Initial location of the stock (give either the paddock name or 'Away'): \")] ",
                "        public string CurrentLocation { get; set; }",
                "",
                "        [Description(\"Standing biomass at which to bring the stock into the simulation (kg DM/ha): \")] ",
                "        public double PreGrazingDM { get; set; }",
                "",
                "        [Description(\"Require > X days of grazable forage before moving stock: \")] ",
                "        [Tooltip(\"To prevent stock being moved too often, require that there be a minimum number of grazing-days of forage available before moving the stock on. The forage needed is very simply set as 3% of the stock liveweight\")] ",
                "        public int MinGrazingDays { get; set; }",
                "",
                "        [Description(\"Standing biomass at which to exit  stock from the simulation (kg DM/ha): \")] ",
                "        public double PostGrazingDM { get; set; }",
                "",
                "        [Description(\"Implement a no-grazing window? (tick for yes): \")] ",
                "        public bool DoNoGrazingWindow { get; set; }",
                "",
                "        [Description(\"Start of the no-grazing window (dd-MMM)\")] ",
                "        public string NoGrazeStart { get; set; }",
                "",
                "        [Description(\"End of the no-grazing window (dd-MMM)\")] ",
                "        public string NoGrazeEnd { get; set; }",
                "",
                "        [Separator(\"Supplementary feeding\")]",
                "",
                "        [Description(\"Name of the supplement to feed: \")] ",
                "        public string SupplementName { get; set; }",
                "",
                "        [Description(\"Feed the supplement first (i.e. before the new forage is available to the stock)?: \")] ",
                "        public bool SupplementFirst { get; set; }",
                "",
                "        [Description(\"Amount of supplementary feeding offered every day (kg DM /head /day): \")] ",
                "        public double SupplementEveryDay { get; set; }",
                "",
                "        [Description(\"Additional amount of supplement offered when available biomass is low (kg DM /head /day): \")] ",
                "        public double SupplementOnPastureMass { get; set; }",
                "",
                "        [Description(\"Trigger biomass for above rule (kg DM /ha): \")] ",
                "        public double TriggerPastureMass { get; set; }",
                "",
                "        public int NumStock { get; set; }",
                "        public bool GrazingSeasonIsOpen { get; set; } // number of stock on the whole farm",
                "        public double HarvestableBiomass { get; set; }",
                "        public double HarvestableBiomassYesterday { get; set; }",
                "",
                "        // Return a list of genotypes to the properties tab.",
                "        public string[] GetGenotypes()",
                "        {",
                "            if (stock != null)",
                "                return stock.Genotypes.Names.ToArray();",
                "            return null;",
                "        }",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                "        {",
                "            CurrentZone = CurrentLocation;",
                "",
                "            //Debugger.Break();",
                "",
                "            summary.WriteMessage(this, \"Initialising the paddock information\", MessageType.Diagnostic);",
                "",
                "            NumStock = (int)(Math.Round(StockingRate * farm.Area, 0));",
                "",
                "            if (CurrentZone.ToLower() != \"away\")",
                "            {",
                "                BuyStock();",
                "                stock.Move(CurrentZone);",
                "                summary.WriteMessage(this, \" The Stock have been moved to \" + CurrentZone, MessageType.Diagnostic);",
                "            }",
                "",
                "            summary.WriteMessage(this, \"     The number of animals has been rounded to \" + NumStock + \" from \" + (StockingRate * farm.Area), MessageType.Diagnostic);",
                "            summary.WriteMessage(this, \"     The animals will begin in \" + CurrentZone + \" which is paddock number \" + CurrentLocationNum + \" in the simulation\", MessageType.Diagnostic);",
                "            summary.WriteMessage(this, \"     The area of the whole farm is \" + farm.Area + \" ha\", MessageType.Diagnostic);",
                "",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            GrazingSeasonIsOpen = true;",
                "            if (DoNoGrazingWindow)",
                "                GrazingSeasonIsOpen = !DateUtilities.WithinDates(NoGrazeStart, clock.Today, NoGrazeEnd);",
                "",
                "            bool sellSomeStock = false;",
                "            if (!GrazingSeasonIsOpen)",
                "                sellSomeStock = true;",
                "",
                "            // Calculate forage mass in the paddock",
                "            HarvestableBiomass = forages.Where(forage => forage.IsAboveGround)",
                "            \t\t\t\t\t\t    .Sum(forage => forage.Live.Wt + forage.Dead.Wt);",
                "            ",
                "            HarvestableBiomass *= 10;  // Convert to kg/ha",
                "",
                "            if (clock.Today == clock.StartDate)",
                "                HarvestableBiomassYesterday = HarvestableBiomass;",
                "",
                "            double deltaHarvestableBiomass = Math.Max(0.0, HarvestableBiomass - HarvestableBiomassYesterday);",
                "",
                "            if (HarvestableBiomass <= PostGrazingDM)",
                "                sellSomeStock = true;",
                "",
                "            if (CurrentZone == \"Away\")",
                "                sellSomeStock = false;",
                "",
                "            // The 0.03 is the propostion of body mass that the stock might eat",
                "            double minFodder = Math.Max(PreGrazingDM, Math.Max(0.0, (0.03 * MinGrazingDays * NumStock * Weight) - (deltaHarvestableBiomass * MinGrazingDays))); ",
                "            HarvestableBiomassYesterday = HarvestableBiomass;",
                "",
                "            if (CurrentZone == \"Away\" && (HarvestableBiomass >= PreGrazingDM) && HarvestableBiomass >= (PostGrazingDM + minFodder) && GrazingSeasonIsOpen)",
                "            {",
                "                CurrentZone = paddocks[0].Name;",
                "                CurrentLocationNum = paddocks[0].Index;",
                "                BuyStock();",
                "                stock.Move(CurrentZone);",
                "                summary.WriteMessage(this, \"     Buying stock \", MessageType.Diagnostic);",
                "            }",
                "",
                "            if (sellSomeStock)",
                "            {",
                "                CurrentZone = \"Away\";",
                "                CurrentLocationNum = -1;",
                "                SellStock();",
                "                summary.WriteMessage(this, \"     Selling stock \", MessageType.Diagnostic);",
                "            }",
                "",
                "            if (CurrentZone != \"Away\")",
                "            {",
                "                if (SupplementEveryDay > 0)",
                "                {",
                "                    double silageOnHand = supplement.Stores[2 - 1].Stored;",
                "                    if (silageOnHand < SupplementEveryDay * stock.NumberAll)",
                "                    {",
                "                        supplement.Buy(SupplementEveryDay * 30.0 * stock.NumberAll, SupplementName);  // i.e. 1 months worth",
                "                        summary.WriteMessage(this, \"SupplementEveryDay: Buying \" + SupplementName + \" of total amount : \" + (SupplementEveryDay * 90 * stock.NumberAll) + \" kg DM\", MessageType.Diagnostic);",
                "                    }",
                "                    supplement.Feed(SupplementName, SupplementEveryDay * stock.NumberAll, CurrentZone, SupplementFirst);",
                "                }",
                "",
                "                if (SupplementOnPastureMass > 0 && HarvestableBiomass <= TriggerPastureMass)",
                "                {",
                "                    double silageOnHand = supplement.Stores[2 - 1].Stored;",
                "                    if (silageOnHand < SupplementOnPastureMass * stock.NumberAll)",
                "                    {",
                "                        supplement.Buy(SupplementOnPastureMass * 30.0 * stock.NumberAll, SupplementName);  // i.e. 1 months worth",
                "                        summary.WriteMessage(this, \"SupplementOnBiomass: Buying \" + SupplementName + \" of total amount : \" + (SupplementOnPastureMass * 90 * stock.NumberAll) + \" kg DM\", MessageType.Diagnostic);",
                "                    }",
                "                    supplement.Feed(SupplementName, SupplementOnPastureMass * stock.NumberAll, CurrentZone, SupplementFirst);",
                "                }",
                "            }",
                "        }",
                "",
                "",
                "        public void BuyStock()",
                "        {",
                "            CurrentGroupNum = stock.NoGroups + 1;",
                "            StockBuy purchase = new StockBuy();",
                "            purchase.Genotype = Genotype;",
                "            purchase.Number = NumStock;",
                "            purchase.Sex = Sex;",
                "            purchase.Age = Age;       // age in months",
                "            purchase.Weight = Weight;  // live weight in kg",
                "            purchase.UseTag = CurrentGroupNum + 1;",
                "            purchase.MatedTo = purchase.Genotype;",
                "            purchase.Pregnant = Pregnant;  // days pregnant, 0 = non pregnant, 1 = pregnant",
                "            purchase.Lactating = Lactating;  // 0 for dry, 1 for lactating",
                "            purchase.NumYoung = YoungNumber;",
                "            purchase.YoungWt = YoungWt;",
                "",
                "            stock.Buy(purchase);",
                "        }",
                "",
                "        public void SellStock()",
                "        {",
                "            int NumGroups = stock.NoGroups;",
                "",
                "            NumGroups = stock.NoGroups;",
                "            for (int gg = 1; gg <= NumGroups; gg++)",
                "            {",
                "                stock.Sell(stock.Number[gg - 1]);",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "Genotype",
                  "Value": "Friesian"
                },
                {
                  "Key": "Sex",
                  "Value": "Female"
                },
                {
                  "Key": "Age",
                  "Value": "12"
                },
                {
                  "Key": "Weight",
                  "Value": "180"
                },
                {
                  "Key": "Pregnant",
                  "Value": "0"
                },
                {
                  "Key": "Lactating",
                  "Value": "0"
                },
                {
                  "Key": "YoungNumber",
                  "Value": "0"
                },
                {
                  "Key": "YoungWt",
                  "Value": "0"
                },
                {
                  "Key": "StockingRate",
                  "Value": "50"
                },
                {
                  "Key": "CurrentLocation",
                  "Value": "Away"
                },
                {
                  "Key": "PreGrazingDM",
                  "Value": "2000"
                },
                {
                  "Key": "MinGrazingDays",
                  "Value": "7"
                },
                {
                  "Key": "PostGrazingDM",
                  "Value": "1500"
                },
                {
                  "Key": "DoNoGrazingWindow",
                  "Value": "False"
                },
                {
                  "Key": "NoGrazeStart",
                  "Value": "1-Jun"
                },
                {
                  "Key": "NoGrazeEnd",
                  "Value": "31-Jul"
                },
                {
                  "Key": "SupplementName",
                  "Value": "silage"
                },
                {
                  "Key": "SupplementFirst",
                  "Value": "False"
                },
                {
                  "Key": "SupplementEveryDay",
                  "Value": "2"
                },
                {
                  "Key": "SupplementOnPastureMass",
                  "Value": "2"
                },
                {
                  "Key": "TriggerPastureMass",
                  "Value": "2500"
                }
              ],
              "Name": "GrazeForageCrop",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Memo, Models",
              "Text": "**GrazeForageCrop**\r\n\r\nThis is a Manager script that undertakes several duties.\r\n\r\nThe first stack of parameters in GrazeForageCrop sets the type of animals that will be bought and then managed during the simulation. The available options are accessible using a combination of dropdown boxes and data entry fields.\r\n\r\nThe middle stack of parameters sets:\r\n\r\n* The paddock stocking rate – the number of head bought is this times the area of the paddock (click on “Field” to set this away from its default of 1 ha).\r\n* At the start of the simulation the stock can be on the simulated paddock (enter the name of the paddock) absent from the simulation (enter “Away”). If the paddock name is given the stock will be bought at the beginning of the first day and drafted to the paddock.\r\n* The third parameter sets the forage crop biomass that triggers the buying of stock and drafting them onto the paddock. If there are multiple forage species in the paddock the biomass will be the sum of all.\r\n* When forage crop growth rates closely match animal demand, the simulation can oscillate with stock bought just above the grazing trigger and then during that day they graze below the exit value and are sold with the pattern repeating a few days later. To prevent this it is desirable to set a minimum gazing duration. Here this is done very simply by assuming a maximum intake of 3% of liveweight per day.\r\n* The fifth parameter is the biomass at which t terminate the grazing event and sell the stock.\r\n* The last three parameters allow the user to set a no-grazing window of time that overrides the parameters above. To enable this set a tick in the box and enter the date range as dd-mmm. The same window is used each year. Windows can cross year boundaries (e.g. 15-Dec to 10-Jan).\r\n\r\nThe final stack of parameters set some options for supplementary feeding. As noted above, a type of silage has been set up in the supplement store. In this stack of parameters:\r\n\r\n* Give the name (case matters) of the supplement type.\r\n* Indicate if the supplement is to be fed before the stock have access to the crop. The alternative is that it is available day-long and the stock can select between supplement and crop. Ticking the box for feeding first will increase the intake of supplement and decrease the intake of crop. The magnitude of this will depend on the stock, the total feed on offer and the qualities of the supplement and crop.\r\n* The third parameter allows the user to feed the stock supplement on a per head basis every day regardless of the amount of forage crop available.\r\n* The last two parameters allow for feeding only when the forage crop biomass is low with an additional amount of supplement per head per day when the crop biomass is below a given value.\r\n\r\n\r\n\r\n\r\n",
              "Name": "GrazeForageCrop Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Report, Models",
              "VariableNames": [
                "[Clock].Today as Date",
                "Mean of [Stock].NumberAll from [Report].DayAfterLastOutput to [Clock].Today as NumStock",
                "Mean of [Stock].IntakeAll.Weight from [Report].DayAfterLastOutput to [Clock].Today as AveDMIntake",
                "Mean of [Stock].MEIntakeAll from [Report].DayAfterLastOutput to [Clock].Today as AveMEIntake",
                "Mean of [Stock].WeightAll from [Report].DayAfterLastOutput to [Clock].Today as AveBodyMass",
                "Mean of [Stock].CondScoreAll from [Report].DayAfterLastOutput to [Clock].Today as AveConditionScore",
                "Mean of [Stock].MilkWtAll from [Report].DayAfterLastOutput to [Clock].Today as AveMilkWeight4pcCorr",
                "Mean of ([Stock].MilkWtAll * 0.04 * 1.8) from [Report].DayAfterLastOutput to [Clock].Today as AveMilkSolids // note the \"0.04\" is to convert the 4% fat corrected to dry milk fat, the \"1.8\" is on the assumption that protein is 80% of the fat content",
                "Last of [GrazeForageCrop].Script.HarvestableBiomass from [Report].DayAfterLastOutput to [Clock].Today as HarvestableBiomass",
                "Last of [Supplement].stores[2].Stored from [Report].DayAfterLastOutput to [Clock].Today as SupplementRemaining",
                "Last of [Field].PlantainForage.AboveGround.Wt * 10.0 from [Report].DayAfterLastOutput to [Clock].Today as PlantainMass",
                "//Last of [GrazeForageCrop].Script.CurrentLocation from [Report].DayAfterLastOutput to [Clock].Today as StockLocation",
                "[GrazeForageCrop].Script.CurrentLocation as StockLocation",
                "Mean of [Stock].PastIntakeAll.Weight from [Report].DayAfterLastOutput to [Clock].Today as AvePlantainIntake",
                "Mean of ([Stock].SuppIntakeAll.Weight + [Stock].PastIntakeAll.Weight)  from [Report].DayAfterLastOutput to [Clock].Today as AveSilagePlusPlantainIntake",
                "Mean of ([Stock].PastIntakeAll.N / ([Stock].PastIntakeAll.Weight + 0.001)) from [Report].DayAfterLastOutput to [Clock].Today as AvePlantainNContent",
                "Mean of [Field].PlantainForage.AboveGround.NConc",
                "Mean of [Stock].MEIntakeAll / ([Stock].IntakeAll.Weight + 0.001) from [Report].DayAfterLastOutput to [Clock].Today as AveMEConcIntake"
              ],
              "EventNames": [
                "[Clock].EndOfDay"
              ],
              "GroupByVariableName": null,
              "Name": "Report",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },

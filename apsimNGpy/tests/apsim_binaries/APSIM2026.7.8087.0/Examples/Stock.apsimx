            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Soils;",
                "using System.Linq;",
                "using System;",
                "using Models.Core;",
                "using Models.Utilities;",
                "using Models.GrazPlan;",
                "using APSIM.Shared.Utilities;",
                "using System.Diagnostics;",
                "",
                "namespace Models",
                "{",
                "",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock clock;",
                "        [Link] Stock stock;",
                "        [Link] Supplement supplement;",
                "        [Link] ISummary summary;",
                "        [Link] Simulation farm;",
                "",
                "        public enum Genotypes",
                "        {",
                "            Friesian,",
                "            Jersey,",
                "            EternalKiwiCross",
                "        }",
                "",
                "        [Separator(\"Stock type info, the same type of stock are brought onto the paddock at each grazing\")]",
                "",
                "        [Description(\"Stock: genotype (e.g. Friesian, Jersey):\")] ",
                "        public Genotypes Genotype { get; set; }",
                "",
                "        [Description(\"Stock: sex (Female, Male, Castrate):\")] ",
                "        public ReproductiveType Sex { get; set; }",
                "",
                "        [Description(\"Stock: age (months):\")] ",
                "        public double Age { get; set; }",
                "",
                "        [Description(\"Stock: weight (kg liveweight /head):\")] ",
                "        public double Weight { get; set; }",
                "",
                "        [Description(\"Stock: fertility status (0 if non-pregnant or days since conception):\")] ",
                "        public int Pregnant { get; set; }",
                "",
                "        [Description(\"Stock: lactation status (0 if non-lactating or days since parturition):\")]",
                "        public int Lactating { get; set; }",
                "",
                "        [Description(\"Stock: Number of young (foetuses or calves):\")]",
                "        public int NumYoung { get; set; }",
                "",
                "        public void ChangeStockNum(int NumCowsToChange, string NewLocation)",
                "        {",
                "            if (NumCowsToChange > 0)",
                "            {",
                "                int preg = Pregnant;",
                "                int lact = Lactating;",
                "                int numyoung = NumYoung;",
                "",
                "                if (stock.AnimalGroups.Count == 2)",
                "                {",
                "                    preg = stock.AnimalGroups[1].Pregnancy;",
                "                    lact = stock.AnimalGroups[1].Lactation;",
                "                    numyoung = stock.AnimalGroups[1].NoFoetuses;",
                "                }",
                "",
                "                StockBuy purchase = new StockBuy();",
                "                purchase.Genotype = ReflectionUtilities.EnumToString(Genotype);",
                "                purchase.Number = NumCowsToChange; //from the Operations file; positive is buy, negative is sell",
                "                purchase.Sex = Sex;",
                "                purchase.Age = Age;       // age in months",
                "                purchase.Weight = Weight;  // liveweight in kg",
                "                purchase.UseTag = 1;",
                "                purchase.MatedTo = purchase.Genotype;",
                "                purchase.Pregnant = preg;   // days pregnant",
                "                purchase.Lactating = lact;  // days lactating",
                "                purchase.NumYoung = numyoung;    // cows can be bought lactating with no young",
                "",
                "                stock.Buy(purchase);",
                "",
                "                stock.Move(NewLocation);",
                "",
                "            }",
                "",
                "            if (NumCowsToChange < 0)",
                "                stock.Sell(-NumCowsToChange);",
                "        }",
                "    ",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "Genotype",
                  "Value": "Friesian"
                },
                {
                  "Key": "Sex",
                  "Value": "Female"
                },
                {
                  "Key": "Age",
                  "Value": "48"
                },
                {
                  "Key": "Weight",
                  "Value": "480"
                },
                {
                  "Key": "Pregnant",
                  "Value": "0"
                },
                {
                  "Key": "Lactating",
                  "Value": "2"
                },
                {
                  "Key": "NumYoung",
                  "Value": "0"
                }
              ],
              "Name": "ChangeLactatingCowNumber",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
